    text(font: cap-font, size: 9pt, fill: quiet)[Стенд], text(size: 9.5pt)[USB-MIDI + USB-консоль, автотесты на pytest],
    text(font: cap-font, size: 9pt, fill: quiet)[Дата прогона], text(size: 9.5pt)[2 октября 2026 г.],
  )
]

// оборот титула
#page(header: none, footer: none)[
