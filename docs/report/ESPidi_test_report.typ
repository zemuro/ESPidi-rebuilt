#page(header: none, footer: none, margin: (inside: 2.6cm, outside: 2.2cm, top: 3cm, bottom: 2.6cm))[
  #set par(first-line-indent: 0pt, justify: false)
  #text(font: cap-font, size: 10pt, fill: accent, tracking: 0.2em)[ОТЧЁТ О ТЕСТИРОВАНИИ]
  #v(1.4cm)
