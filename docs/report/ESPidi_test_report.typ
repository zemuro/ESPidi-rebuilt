// ESPidi — отчёт о тестировании прошивки на устройстве (книжная вёрстка)
// Сборка: build.ps1 (шрифты PT Serif Pro через --font-path)

#let ink = rgb("#1b1b1b")
#let accent = rgb("#7a2e1d")       // приглушённый кирпичный — для акцентов
#let rule-col = luma(170)
#let quiet = luma(95)
#let body-font = ("PTSerifPro-Book",)
#let head-font = ("PTSerifPro", "PTSerifPro-Book")
#let ital-font = ("PTSerifPro-BookItalic", "PTSerifPro-Book")
#let cap-font = ("PTSerifPro-Caption", "PTSerifPro-Book")
#let mono = ("Consolas", "DejaVu Sans Mono")
#let doc-title = "ESPidi: результаты тестов прошивки"

#set document(title: doc-title, author: "ESPidi-rebuilt")
#set text(font: body-font, size: 10.5pt, lang: "ru", fill: ink, hyphenate: true)
#set par(justify: true, leading: 0.72em, first-line-indent: 1.2em, spacing: 0.72em)
#show emph: set text(font: ital-font)
#show strong: set text(font: head-font)
#show raw: set text(font: mono, size: 0.86em)
#show link: set text(fill: accent)
#show figure.caption: set text(font: cap-font, size: 8.5pt, fill: quiet)
#show heading: set text(hyphenate: false)

// ---------- страница: двусторонняя, колонтитулы ----------
#let chapter-title() = {
  let hs = query(heading.where(level: 1).before(here()))
  if hs.len() > 0 { hs.last().body } else { none }
}
#let is-chapter-page() = {
  let hs = query(heading.where(level: 1))
  hs.any(h => h.location().page() == here().page())
}

#set page(
  paper: "iso-b5",
  margin: (inside: 2.4cm, outside: 1.9cm, top: 2.4cm, bottom: 2.3cm),
  binding: left,
  header: context {
    if here().page() <= 2 or is-chapter-page() { return }
    set text(font: cap-font, size: 8.5pt, fill: quiet)
    let even = calc.even(here().page())
    if even [#upper(doc-title) #h(1fr)] else [#h(1fr) #chapter-title()]
    v(-6pt)
    line(length: 100%, stroke: 0.4pt + rule-col)
  },
  footer: context {
    if here().page() <= 1 { return }
    set text(font: cap-font, size: 9pt, fill: quiet)
    let n = counter(page).display()
    if calc.even(here().page()) [#n #h(1fr)] else [#h(1fr) #n]
  },
)

// ---------- заголовки ----------
#set heading(numbering: (..n) => if n.pos().len() == 1 { str(n.pos().first()) } else { none })
#show heading.where(level: 1): it => {
  pagebreak(weak: true)
  v(2.2cm)
  set par(first-line-indent: 0pt, justify: false)
  if it.numbering != none {
    text(font: cap-font, size: 10pt, fill: accent, tracking: 0.12em)[ГЛАВА #counter(heading).display()]
    v(4pt)
  }
  text(font: head-font, size: 22pt, it.body)
  v(6pt)
  line(length: 2.2cm, stroke: 1pt + accent)
  v(1.1cm)
}
#show heading.where(level: 2): it => {
  v(1.1em)
  set par(first-line-indent: 0pt, justify: false)
  block(sticky: true, text(font: head-font, size: 12.5pt, it.body))
  v(0.3em)
}

// ---------- элементы ----------
#let lead(body) = {
  set par(first-line-indent: 0pt)
  text(size: 11.5pt, body)
}

#let keyfig(value, label) = block(
  above: 0.4em, below: 0.9em, breakable: false,
  grid(columns: (auto, 1fr), column-gutter: 10pt, align: (left + horizon, left + horizon),
    text(font: head-font, size: 19pt, fill: accent, value),
    text(font: cap-font, size: 9pt, fill: quiet, label)))

// Дефект: заголовок с кодом, ключевая цифра, четыре абзаца с подписями
#let defect(id, title, fig: none, figlabel: none, what, why, how, shows) = {
  block(sticky: true, above: 1.6em, below: 0.5em, {
    set par(first-line-indent: 0pt, justify: false)
    text(font: cap-font, size: 9pt, fill: accent, tracking: 0.08em, id)
    h(8pt)
    text(font: head-font, size: 12.5pt, title)
  })
  if fig != none { keyfig(fig, figlabel) }
  set par(first-line-indent: 0pt)
  let item(label, body) = block(above: 0.55em, below: 0.55em)[#text(font: ital-font, fill: accent)[#label.] #body]
  item("Что происходит", what)
  item("Почему мешает", why)
  item("Как измерено", how)
  item("Как проявляется", shows)
}

#let ornament = align(center, text(fill: rule-col, size: 12pt)[✻ #h(6pt) ✻ #h(6pt) ✻])

// Горизонтальная столбчатая диаграмма, нарисованная средствами Typst
#let hbars(rows, refs: (), unit: "мс", accent-n: 2, label-w: 5.6cm, bar-w: 5.2cm) = {
  let peak = calc.max(..rows.map(r => r.at(1)))
  let x(v) = v / peak * bar-w
  let sorted = rows.map(r => r.at(1)).sorted().rev()
  let cutoff = sorted.at(accent-n - 1)
  let row-h = 0.62cm
  let total-h = rows.len() * row-h
  set par(first-line-indent: 0pt, justify: false)
  block(breakable: false, {
    box(width: label-w + bar-w + 1.8cm, height: total-h + 0.9cm, {
      for (i, r) in rows.enumerate() {
        let (label, v) = r
        let y = i * row-h
        place(dx: 0pt, dy: y + 0.12cm, box(width: label-w - 8pt, align(right, text(size: 9pt, hyphenate: false, label))))
        place(dx: label-w, dy: y + 0.1cm,
          rect(width: x(v), height: row-h - 0.24cm, stroke: none,
            fill: if v >= cutoff { accent } else { luma(205) }))
        place(dx: label-w + calc.max(x(v), x(refs.map(f => f.at(1)).fold(0, calc.max))) + 5pt, dy: y + 0.12cm,
          text(size: 9pt, str(v).replace(".", ",") + " " + unit))
      }
      for (k, f) in refs.enumerate() {
        let (label, v) = f
        place(dx: label-w + x(v), dy: -0.1cm,
          line(start: (0pt, 0pt), end: (0pt, total-h + 0.2cm), stroke: (paint: quiet, thickness: 0.5pt, dash: "dashed")))
        place(dx: label-w + x(v) - 1cm, dy: total-h + 0.18cm + k * 0.34cm,
          box(width: 2cm, align(center, text(font: cap-font, size: 7.5pt, fill: quiet, label))))
      }
    })
  })
}

#let tbl(columns, ..cells) = {
  set par(first-line-indent: 0pt, justify: false)
  set text(size: 9.2pt)
  table(columns: columns, stroke: none, inset: (x: 5pt, y: 4pt),
    table.hline(stroke: 0.8pt + ink),
    ..cells,
    table.hline(stroke: 0.8pt + ink))
}

