  [DIV], [1/1 … 1/32], [Длительность шага паттерна в этом шаге песни; по умолчанию 1/4.],
  [SLOT], [1…LENGTH], [Выбор шага песни (правая колонка); нажатие энкодера — MUTE.],
)

