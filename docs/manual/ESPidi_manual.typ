    set text(font: mono, fill: white, size: 8.2pt)
    grid(columns: (1.2fr, 1fr, 1.2fr, 10pt), column-gutter: 4pt,
      [C4 \ E4 \ G4], [\* \ +3], [CC74:100 \ CC1:20], align(right, [▶ \ 1]))
    v(2pt)
