// ---------- помощники ----------

#let callout(label, color, bg, body) = block(
  fill: bg, stroke: (left: 2.5pt + color),
  inset: (x: 10pt, y: 7pt), width: 100%, radius: (right: 2pt), breakable: false,
  [#text(font: head-font, fill: color, size: 9.5pt, upper(label)) #h(4pt) #body])

#let note(body) = callout("Важно", accent, rgb("#eef3f8"), body)
#let warn(body) = callout("Осторожно", warm, rgb("#fbf1e6"), body)
#let tip(body) = callout("Совет", rgb("#2f6b5e"), rgb("#edf5f2"), body)
#let try-it(body) = callout("Попробуйте", rgb("#7a2e1d"), rgb("#f8efec"), body)

// Сценарий: заголовок и пронумерованные шаги
#let scene(title, body) = block(
  stroke: 0.5pt + luma(170), inset: (x: 12pt, y: 9pt), radius: 3pt, width: 100%, breakable: false, {
    text(font: head-font, size: 11pt, fill: accent)[#title]
    v(2pt)
    body
  })

#let key(k) = box(
  fill: luma(240), stroke: 0.5pt + luma(150), radius: 2pt,
  inset: (x: 3.5pt, y: 1.5pt), baseline: 1.5pt,
  text(font: mono, size: 0.82em, k))

// Макет экрана OLED 128×32: две колонки по 3 строки + нижняя строка
#let oled(lcol, rcol, bottom: "", icon: "▶") = block(
  fill: black, inset: 7pt, radius: 3pt, width: 8.2cm, breakable: false, {
    set text(font: mono, fill: white, size: 8.2pt)
    set par(leading: 0.35em, justify: false)
    grid(columns: (1fr, 1fr, 10pt), column-gutter: 4pt,
      stack(spacing: 2.5pt, ..lcol.slice(0, calc.min(3, lcol.len())).map(l => [#l])),
      stack(spacing: 2.5pt, ..rcol.slice(0, calc.min(3, rcol.len())).map(l => [#l])),
      align(top + right, icon))
    v(2pt)
    bottom
  })

#let cells(pattern) = {
  // # — шаг с нотой, . — пустой, C — с CC, P — играющий шаг
  pattern.clusters().map(c => if c == "#" { box(width: 7pt, height: 7pt, fill: white, stroke: white) }
    else if c == "." { box(width: 7pt, height: 7pt, stroke: white) }
    else if c == "C" { box(width: 7pt, height: 7pt, fill: white, stroke: white, text(fill: black, size: 6pt, baseline: -1pt)[\~]) }
    else if c == "P" { box(width: 9pt, height: 9pt, stroke: white, inset: 0pt, align(center + horizon, box(width: 7pt, height: 7pt, fill: white))) }
    else { h(1pt) }).join(h(1pt))
}

#let tbl(columns, ..rows) = {
  set text(size: 9.5pt)
  set par(justify: false)
  table(columns: columns, stroke: 0.4pt + luma(170), inset: (x: 6pt, y: 4.5pt),
    fill: (_, row) => if row == 0 { rgb("#e3ebf3") } else { none },
    ..rows)
}

