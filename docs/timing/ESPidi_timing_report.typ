  [CC 123 за 5 шагов секвенсора (C4)], [80], [80], [0], [0],
  [Clock с MIDI IN на MIDI OUT (G3)], [82 из 82], [82 из 82], [82 из 82], [82 из 82],
  [Поток 5000 CC на вход: потеряно (H1)], [0], [0], [0], [0],
